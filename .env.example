# Copy to .env, or configure provider settings in the dashboard.
# Set the key for your chosen AI provider. Built-in commands need no AI key.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional explicit model ID. Leave empty to select a default for the configured key.
AGENT_BRAIN_MODEL=

# Local or remote Ollama endpoint. Install a model server and model separately.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Optional OpenAI-compatible endpoint.
CUSTOM_API_BASE=
CUSTOM_API_KEY=

# Optional Telegram text gateway; pair from the dashboard before remote use.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
