# PRIVACY68 - Out-of-the-Box Configuration (OpenClaw / OpenClaude style)
# Copy this file to '.env' or enter your API key directly in the Dashboard UI.

# 1. Anthropic Claude API Key (Instant frontier intelligence, zero local downloads)
# Get key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 2. (Optional) Groq Cloud API Key (Free ~99% speech accuracy and ultra-fast whisper)
# Get free key in 10 seconds: https://console.groq.com/keys
GROQ_API_KEY=

# 3. Active AI Model (Default: claude-3-5-sonnet-20241022 when key is present)
# Options: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, groq/llama-3.3-70b-versatile, ollama/llama3.2:latest
AGENT_BRAIN_MODEL=claude-3-5-sonnet-20241022

# 4. Ollama Configuration (Local daemon or remote Website / Cloud Ollama endpoint)
# Local default: "http://localhost:11434"
# Website / Cloud Ollama example: "https://ollama.your-website.com" or "http://your-server-ip:11434"
OLLAMA_BASE_URL=http://localhost:11434
# Optional Bearer Token / API Key if remote website is protected
OLLAMA_API_KEY=

