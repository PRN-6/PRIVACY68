# PRIVACY68 - Out-of-the-Box Configuration (OpenClaw / OpenClaude style)
# Copy this file to '.env' or enter your API key directly in the Dashboard UI.

# 1. Google Gemini API Key (Ultra-fast reasoning with free tier)
# Get free key in seconds: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Anthropic Claude API Key (Instant frontier intelligence, zero local downloads)
# Get key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 3. (Optional) Groq Cloud API Key (Free tier Llama 3.3 70B reasoning for AI Brain)
# Get free key in 10 seconds: https://console.groq.com/keys
GROQ_API_KEY=

# 4. (Optional) OpenAI API Key (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# 5. Active AI Model (Default: gemini/gemini-1.5-flash, groq/llama-3.3-70b-versatile, or claude-3-5-sonnet-20241022)
# Options: gemini/gemini-1.5-flash, gemini/gemini-2.0-flash, groq/llama-3.3-70b-versatile, claude-3-5-sonnet-20241022, openai/gpt-4o-mini, ollama/llama3.2:latest
AGENT_BRAIN_MODEL=gemini/gemini-1.5-flash

# 6. Speech-to-Text Engine (100% Free Google Web Speech - Zero Setup)
SPEECH_ENGINE=google

# 7. Ollama Configuration (Local daemon or remote Website / Cloud Ollama endpoint)
# Local default: "http://localhost:11434"
# Website / Cloud Ollama example: "https://ollama.your-website.com" or "http://your-server-ip:11434"
OLLAMA_BASE_URL=http://localhost:11434
# Optional Bearer Token / API Key if remote website is protected
OLLAMA_API_KEY=

